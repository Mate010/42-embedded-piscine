#include <avr/io.h>
#include <util/delay.h>
#include <avr/interrupt.h>

/*
https://ww1.microchip.com/downloads/en/DeviceDoc/ATmega48A-PA-88A-PA-168A-PA-328-P-DS-DS40002061A.pdf
 184 : USART Initialization
 202 : UMSELn Bits Settings
*/
void uart_init()
{
	/*
		ubrr = (F_CPU / prescale / UART_BAUDRATE) - 1 <- (en theorie)	
	*/
	uint16_t ubrr = (F_CPU / 16 / 115200);

	/*
	baud rate (vitesse de communication): 
		p204 : 20.11.5 UBRRnL and UBRRnH – USART Baud Rate Registers 
		UBRR0H : USART Baud Rate Register 0 High
		UBRR0L : USART Baud Rate Register 0 Low
			permet de faire rentrer le ubrr qui est dans 16 bit dans deux 8 bits
	*/
	UBRR0H = (ubrr << 8);
	UBRR0L =  ubrr;

	/*
	
		UCSR0B : UCSRnB – USART Control and Status Register n B / 
		TXEN0 : Transmitter Enable n / Active la transmition
		RXEN0 : Receiver Enable n / Acvtive la reception
		
	*/
	UCSR0B = (1 << TXEN0) | (1 << RXEN0);

	/*	
		p 203	
		active le syteme 8N1 (0 00000000 1)
	*/
	UCSR0C = (1 << UCSZ01) | (1 << UCSZ00);
}



